.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*

# Logs and Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing
coverage/
.nyc_output/

